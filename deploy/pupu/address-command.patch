+def _login_account_executor(
+    *, account_id: str, accounts_root: Path, data_root: Path,
+):
+    from pupu_assistant.integrations.pupu.account_gateway import HouseholdOperationExecutor
+    from pupu_assistant.integrations.pupu.login_accounts import login_account_paths
+    from pupu_assistant.integrations.pupu.network_executor import PupuNetworkExecutor
+
+    paths = login_account_paths(account_id=account_id, root=accounts_root)
+    if not paths.auth_path.exists():
+        raise ValueError("verified Pupu login is required")
+    auth = json.loads(paths.auth_path.read_text(encoding="utf-8-sig"))
+    if not isinstance(auth, dict):
+        raise ValueError("saved Pupu auth is invalid")
+    network = PupuNetworkExecutor(config=auth, repo_root=_repo_root())
+    return (
+        HouseholdOperationExecutor(
+            household_id=account_id, data_root=data_root, send=network,
+            allowed_risks={"read_only", "account_session"},
+        ),
+        paths,
+        auth,
+    )
+
+async def _list_login_account_addresses(
+    *, account_id: str, accounts_root: Path, data_root: Path, lng_x: str, lat_y: str,
+) -> dict[str, object]:
+    from pupu_assistant.integrations.pupu.account_service import PupuAccountService
+    from pupu_assistant.integrations.pupu.address_command import (
+        access_token_expired,
+        summarize_receiver_addresses,
+    )
+    from pupu_assistant.integrations.pupu.operations import build_operation_request
+
+    executor, paths, auth = _login_account_executor(
+        account_id=account_id, accounts_root=accounts_root, data_root=data_root,
+    )
+    if access_token_expired(auth):
+        await PupuAccountService(
+            executor, auth_path=paths.auth_path, config=auth,
+        ).refresh()
+        executor, _, _ = _login_account_executor(
+            account_id=account_id, accounts_root=accounts_root, data_root=data_root,
+        )
+    response = await executor(build_operation_request(
+        "receiver-list", {"receiver": {"lng_x": lng_x, "lat_y": lat_y}},
+    ))
+    return summarize_receiver_addresses(response)
+
