+++ b/src/pupu_assistant/integrations/pupu/address_command.py
@@ -0,0 +1,73 @@
+from __future__ import annotations
+
+import base64
+import json
+import time
+from collections.abc import Mapping
+from typing import Any
+
+def _mapping(value: Any) -> Mapping[str, Any]:
+    return value if isinstance(value, Mapping) else {}
+
+
+def access_token_expired(
+    config: Mapping[str, Any],
+    *,
+    now_seconds: int | None = None,
+    skew_seconds: int = 30,
+) -> bool:
+    authorization = _text(_mapping(config.get("headers")).get("authorization"))
+    token = authorization.split()[-1] if authorization else ""
+    parts = token.split(".")
+    if len(parts) != 3:
+        return True
+    try:
+        raw = parts[1] + "=" * (-len(parts[1]) % 4)
+        claims = json.loads(base64.urlsafe_b64decode(raw))
+        expires_at = int(claims["exp"])
+    except (ValueError, KeyError, TypeError, json.JSONDecodeError):
+        return True
+    active_now = int(time.time()) if now_seconds is None else now_seconds
+    return expires_at <= active_now + skew_seconds
+
+def _text(value: Any) -> str:
+    return str(value).strip() if value not in (None, "") else ""
+
+def _candidates(payload: Mapping[str, Any]) -> list[Mapping[str, Any]]:
+    data = _mapping(payload.get("data")) or payload
+    result: list[Mapping[str, Any]] = []
+    for key in ("recommend_receiver_list", "normal_receiver_list"):
+        values = data.get(key)
+        if isinstance(values, list):
+            result.extend(value for value in values if isinstance(value, Mapping))
+    return result
+
+def summarize_receiver_addresses(payload: Mapping[str, Any]) -> dict[str, object]:
+    addresses: list[dict[str, object]] = []
+    seen: set[str] = set()
+    for receiver in _candidates(payload):
+        receiver_id = _text(receiver.get("id"))
+        place = _mapping(receiver.get("place"))
+        store_id = _text(receiver.get("service_store_id") or place.get("service_store_id"))
+        place_id = _text(place.get("id"))
+        try:
+            place_zip = int(place.get("zip"))
+        except (TypeError, ValueError):
+            continue
+        if not receiver_id or not store_id or not place_id or place_zip <= 0:
+            continue
+        if receiver_id in seen:
+            continue
+        seen.add(receiver_id)
+        city = _text(receiver.get("city_name"))
+        area = _text(receiver.get("area_name"))
+        addresses.append({
+            "id": receiver_id,
+            "label": f"地址 {len(addresses) + 1}",
+            "region": f"{city}{area}" or "已保存区域",
+            "detailHint": _text(receiver.get("building_room_num")) or "详细地址已保护",
+            "phoneSuffix": "",
+            "service_store_id": store_id,
+            "place": {"id": place_id, "zip": place_zip},
+        })
+    return {"addresses": addresses}
--- a/tests/test_address_command.py
+++ b/tests/test_address_command.py
@@ -0,0 +1,74 @@
+from pupu_assistant.integrations.pupu.address_command import access_token_expired, summarize_receiver_addresses
+
+
+def test_summarizes_receiver_list_without_sensitive_fields():
+    payload = {
+        "data": {
+            "recommend_receiver_list": [{
+                "id": "receiver-a",
+                "name": "家",
+                "city_name": "福州市",
+                "area_name": "鼓楼区",
+                "address": "测试路 88 号",
+                "building_room_num": "3 栋 1201",
+                "mobile": "13000009501",
+                "service_store_id": "store-a",
+                "place": {"id": "place-a", "zip": 350100},
+                "lng_x": "encrypted-longitude",
+                "lat_y": "encrypted-latitude",
+            }],
+            "normal_receiver_list": [],
+        }
+    }
+
+    result = summarize_receiver_addresses(payload)
+
+    assert result == {"addresses": [{
+        "id": "receiver-a",
+        "label": "地址 1",
+        "region": "福州市鼓楼区",
+        "detailHint": "3 栋 1201",
+        "phoneSuffix": "",
+        "service_store_id": "store-a",
+        "place": {"id": "place-a", "zip": 350100},
+    }]}
+    serialized = repr(result)
+    assert "测试路" not in serialized
+    assert "13000009501" not in serialized
+    assert "encrypted-" not in serialized
+
+
+def test_deduplicates_recommended_and_normal_receivers():
+    receiver = {
+        "id": "receiver-a",
+        "service_store_id": "store-a",
+        "place": {"id": "place-a", "zip": 350100},
+    }
+    result = summarize_receiver_addresses({"data": {
+        "recommend_receiver_list": [receiver],
+        "normal_receiver_list": [receiver],
+    }})
+    assert len(result["addresses"]) == 1
+
+
+def test_rejects_incomplete_receiver_bindings():
+    result = summarize_receiver_addresses({"data": {
+        "normal_receiver_list": [{"id": "receiver-a"}],
+    }})
+    assert result == {"addresses": []}
+
+def test_detects_expired_access_token_without_exposing_it():
+    import base64
+    import json
+
+    def jwt(exp):
+        body = base64.urlsafe_b64encode(json.dumps({"exp": exp}).encode()).decode().rstrip("=")
+        return f"header.{body}.signature"
+
+    assert access_token_expired({"headers": {
+        "authorization": f"Bearer {jwt(100)}",
+    }}, now_seconds=101)
+    assert not access_token_expired({"headers": {
+        "authorization": f"Bearer {jwt(200)}",
+    }}, now_seconds=101)
+
